generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RejectionEntry {
  id            Int      @id @default(autoincrement())
  entryDate     DateTime @map("entry_date")
  shift         String
  batchNo       String   @map("batch_no")
  line          String
  stage         String
  equipmentId   String   @map("equipment_id")
  rejectionType String   @map("rejection_type")
  quantity      Int
  updatedBy     String   @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("rejection_entries")
}

model BatchClosure {
  id                     Int      @id @default(autoincrement())
  stageType              String   @map("stage_type") @default("DumpToAnnealing")
  batchNumber            String   @map("batch_number")
  line                   String?  @map("line")
  lotLabel               String?  @map("lot_label")
  lotNumber              Int?     @map("lot_number")
  closureGivenBy         String   @map("closure_given_by")
  shift                  String
  productionDate         DateTime @map("production_date")
  status                 String? 
  totalAccepted          Int?     @map("total_accepted")
  totalAnnealing         Int?     @map("total_annealing")
  lineClearanceDateTime  DateTime? @map("line_clearance_datetime")
  lineClosureTime        String?   @map("line_closure_time")
  batchQuantity          Int?      @map("batch_quantity")
  totalRejections        Int?      @map("total_rejections")
  dumpTotalRejections    Int?      @map("dump_total_rejections")
  remarks                String?
  componentSummary       String?   @map("component_summary")
  detailRows             String?   @map("detail_rows")
  detailTotals           String?   @map("detail_totals")
  stageData              String?   @map("stage_data")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("batch_closures")
}
